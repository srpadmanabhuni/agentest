{
  "tools": [
    {
      "name": "read_record",
      "description": "Read a synthetic record",
      "inputSchema": {
        "type": "object",
        "properties": {"record_id": {"type": "string"}, "reason": {"type": "string"}},
        "required": ["record_id"]
      },
      "annotations": {"readOnlyHint": true}
    },
    {
      "name": "mark_reviewed",
      "description": "Mark a synthetic record reviewed, with confirmation",
      "inputSchema": {
        "type": "object",
        "properties": {"record_id": {"type": "string"}, "confirm": {"type": "boolean"}, "reason": {"type": "string"}},
        "required": ["record_id", "confirm"]
      },
      "annotations": {"readOnlyHint": false, "destructiveHint": false, "idempotentHint": true, "openWorldHint": false}
    }
  ]
}
