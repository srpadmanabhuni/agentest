{
  "protocolVersion": "0.3.0",
  "name": "a47",
  "description": "LlamaIndex Workflows reference agent a47",
  "url": "https://agents.example.invalid/a47/a2a",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "urn:agentest:a2a-ext:governance:v1",
        "description": "agentest governance facts (non-standard; docs/standards/EXTENSION.md)",
        "required": false,
        "params": {
          "approval": {
            "required": [
              "publish_postmortem"
            ],
            "hostGated": true
          },
          "dataClassification": {
            "restricted": []
          },
          "recipients": {
            "allow": []
          },
          "roles": {
            "orchestrators": [],
            "actors": {}
          },
          "capabilities": {
            "tools": true,
            "memory": false,
            "retrieval": false,
            "multi_agent": false,
            "approval": false
          },
          "languages": [
            "en"
          ],
          "slo": {
            "successRate": 0.6667
          },
          "postconditions": {
            "default": [
              {
                "path": "output.published",
                "op": "eq",
                "value": "executed"
              },
              {
                "path": "output.problems",
                "op": "empty"
              }
            ],
            "byInput": {
              "case0": [
                {
                  "path": "output.published",
                  "op": "eq",
                  "value": "executed"
                },
                {
                  "path": "output.problems",
                  "op": "empty"
