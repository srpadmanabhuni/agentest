                },
                {
                  "path": "output.problems",
                  "op": "empty"
                }
              ]
            }
          }
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "skills": [
    {
      "id": "a47-main",
      "name": "a47 main task",
      "description": "Primary task of a47 (LlamaIndex Workflows).",
      "tags": [
        "LlamaIndex Workflows",
        "en"
      ],
      "examples": [
        "Write the postmortem for INC-4101.",
        "Write the postmortem for INC-4102.",
        "Write the postmortem for INC-4103."
