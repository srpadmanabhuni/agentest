{
  "protocolVersion": "0.3.0",
  "name": "a41",
  "description": "smolagents reference agent a41",
  "url": "https://agents.example.invalid/a41/a2a",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
