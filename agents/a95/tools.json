          "number": {
            "type": "integer"
          }
        },
        "required": [
          "to",
          "number"
        ]
      },
      "annotations": {
        "title": "notify_author",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
