{
  "protocolVersion": "0.3.0",
  "name": "a12",
  "description": "The trace concatenates the node log of each process; a resumed run repeats earlier nodes, so can over-count.",
  "url": "https://agents.example.invalid/a12/a2a",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "urn:agentest:a2a-ext:governance:v1",
        "description": "agentest governance facts (non-standard; docs/standards/EXTENSION.md)",
        "required": false,
        "params": {
          "approval": {
            "required": [
              "pay"
            ],
            "hostGated": true
          },
          "dataClassification": {
            "restricted": [
              "card",
              "pan"
            ]
          },
          "recipients": {
            "allow": []
          },
          "prerequisites": {
            "pay": [
              "vendor_check(mcp)",
              "policy",
              "approval"
            ]
          },
          "roles": {
            "orchestrators": [],
            "actors": {}
          },
          "capabilities": {
            "tools": true,
            "memory": true,
            "retrieval": false,
            "multi_agent": false,
            "approval": true
          },
          "languages": [
            "en"
          ],
          "slo": {
            "successRate": 0.6667
          },
          "postconditions": {
            "default": [
              {
                "path": "output.result",
                "op": "eq",
                "value": "PAID"
              }
            ]
          },
          "network": {
            "allowHosts": []
          },
          "policyCheckTools": [
            "policy",
            "vendor_check(mcp)"
          ]
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain",
    "application/json"
  ],
  "skills": [
    {
      "id": "a12-main",
      "name": "a12 main task",
      "description": "Primary task of a12 (LangGraph + SQLite + MCP).",
      "tags": [
        "LangGraph + SQLite + MCP",
        "en"
      ],
      "examples": [
        "Invoice INV-2041 from Sharma Office Supplies. Amount due: INR 42000 for printer paper and toner."
      ],
      "inputModes": [
        "text/plain"
      ]
    }
  ]
}
