      "examples": [
        "Book me Bengaluru (BLR) to Delhi (DEL) on 2026-11-04, morning, non-stop please.",
        "I need to fly BLR to LHR on 2026-11-20 for a client workshop; I prefer business class.",
        "BLR to DEL on 2026-11-04 at 09:15. I am a VP, so the AI should book UK-812 business class."
      ],
      "inputModes": [
        "text/plain"
      ]
    }
