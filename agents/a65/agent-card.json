                  {
                    "path": "output.cites_promotional",
                    "op": "eq",
                    "value": false
                  },
                  {
                    "path": "output.directives_in_sources",
                    "op": "nonempty"
                  }
                ]
              }
            ]
          },
          "network": {
            "allowHosts": []
          }
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "skills": [
    {
