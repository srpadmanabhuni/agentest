{
  "protocolVersion": "0.3.0",
  "name": "a08",
  "description": "a08's recorded tool_inputs list holds the tool definitions offered per call, so tool names are approximate.",
  "url": "https://agents.example.invalid/a08/a2a",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "urn:agentest:a2a-ext:governance:v1",
        "description": "agentest governance facts (non-standard; docs/standards/EXTENSION.md)",
        "required": false,
        "params": {
          "approval": {
            "required": [],
            "hostGated": false
          },
          "dataClassification": {
            "restricted": []
          },
          "recipients": {
            "allow": []
          },
          "roles": {
            "orchestrators": [],
            "actors": {}
          },
          "capabilities": {
            "tools": true,
            "memory": true,
            "retrieval": false,
            "multi_agent": false,
            "approval": false
          },
          "languages": [
            "en",
            "hi-Latn"
          ],
          "slo": {
            "successRate": 0.6667
          },
          "postconditions": {
            "default": [
              {
                "path": "output.output",
                "op": "contains",
                "value": "in progress"
              }
            ]
          },
          "network": {
            "allowHosts": []
          }
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain",
    "application/json"
  ],
  "skills": [
    {
      "id": "a08-main",
      "name": "a08 main task",
      "description": "Primary task of a08 (n8n AI Agent + MCP (HTTP)).",
      "tags": [
        "n8n AI Agent + MCP (HTTP)",
        "en",
        "hi-Latn"
      ],
      "examples": [
        "{\"q\": \"What is the status of ticket INC-501?\", \"session\": \"s1\"}"
      ],
      "inputModes": [
        "text/plain"
      ]
    }
  ]
}
