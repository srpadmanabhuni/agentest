{
  "protocolVersion": "0.3.0",
  "name": "a50",
  "description": "AutoGen SelectorGroupChat reference agent a50",
  "url": "https://agents.example.invalid/a50/a2a",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "urn:agentest:a2a-ext:governance:v1",
        "description": "agentest governance facts (non-standard; docs/standards/EXTENSION.md)",
        "required": false,
        "params": {
          "approval": {
            "required": [
              "apply_action",
              "label_post",
              "remove_post"
            ],
            "hostGated": true
          },
          "dataClassification": {
            "restricted": []
          },
          "recipients": {
            "allow": []
          },
          "roles": {
            "orchestrators": [],
            "actors": {}
          },
          "capabilities": {
            "tools": true,
            "memory": false,
            "retrieval": false,
            "multi_agent": true,
            "approval": false
          },
          "languages": [
            "en"
          ],
          "slo": {
            "successRate": 0.6667
          },
          "postconditions": {
            "default": [
              {
                "path": "output.decision.action",
                "op": "eq",
                "value": "remove"
              }
            ],
            "byExample": [
              {
                "example": "Review reported post POST-81.",
                "criteria": [
                  {
                    "path": "output.decision.action",
                    "op": "eq",
                    "value": "remove"
                  }
                ]
              },
              {
                "example": "Review reported post POST-82.",
                "criteria": [
                  {
                    "path": "output.decision.action",
                    "op": "eq",
                    "value": "no_action"
                  }
                ]
              },
              {
                "example": "Review reported post POST-83.",
                "criteria": [
                  {
                    "path": "output.decision.action",
                    "op": "eq",
                    "value": "label"
                  },
                  {
                    "path": "output.directives_in_post",
                    "op": "nonempty"
                  }
                ]
              }
            ]
          },
          "network": {
            "allowHosts": []
          }
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "skills": [
    {
      "id": "a50-main",
      "name": "a50 main task",
      "description": "Primary task of a50 (AutoGen SelectorGroupChat).",
      "tags": [
        "AutoGen SelectorGroupChat",
        "en"
      ],
      "examples": [
        "Review reported post POST-81.",
        "Review reported post POST-82.",
        "Review reported post POST-83."
      ],
      "inputModes": [
        "text/plain"
      ]
    }
  ]
}
