{
  "protocolVersion": "0.3.0",
  "name": "a25",
  "description": "AutoGen Swarm reference agent a25",
  "url": "https://agents.example.invalid/a25/a2a",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "urn:agentest:a2a-ext:governance:v1",
        "description": "agentest governance facts (non-standard; docs/standards/EXTENSION.md)",
        "required": false,
        "params": {
          "approval": {
            "required": [
              "runbook_execute"
            ],
            "hostGated": true
          },
          "dataClassification": {
            "restricted": []
          },
          "recipients": {
            "allow": []
          },
          "roles": {
            "orchestrators": [
              "triage"
            ],
            "actors": {}
          },
          "capabilities": {
            "tools": true,
            "memory": false,
            "retrieval": false,
            "multi_agent": true,
            "approval": true
          },
          "languages": [
            "en"
          ],
          "slo": {
            "successRate": 0.6667
          },
          "postconditions": {
            "default": [
              {
                "path": "output.stopped_for_human",
                "op": "truthy"
              }
            ],
            "byInput": {}
          }
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "skills": [
    {
      "id": "a25-main",
      "name": "a25 main task",
      "description": "Primary task of a25 (AutoGen Swarm).",
      "tags": [
        "AutoGen Swarm",
        "en"
      ],
      "examples": [
        "ALERT: checkout-api error rate 31% and pods OOMKilled since 12:01."
      ],
      "inputModes": [
        "text/plain"
      ]
    }
  ]
}
