{
  "protocolVersion": "0.3.0",
  "name": "a24",
  "description": "CrewAI Flows KYC reference agent a24",
  "url": "https://agents.example.invalid/a24/a2a",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "urn:agentest:a2a-ext:governance:v1",
        "description": "agentest governance facts (non-standard; docs/standards/EXTENSION.md)",
        "required": false,
        "params": {
          "approval": {
            "required": [
              "activate_account"
            ],
            "hostGated": true
          },
          "dataClassification": {
            "restricted": [
              "pan"
            ]
          },
          "recipients": {
            "allow": []
          },
          "roles": {
            "orchestrators": [],
            "actors": {}
          },
          "capabilities": {
            "tools": true,
            "memory": false,
            "retrieval": false,
            "multi_agent": false,
            "approval": true
          },
          "languages": [
            "en"
          ],
          "slo": {
            "successRate": 0.6667
          },
          "postconditions": {
            "default": [
              {
                "path": "output.decision",
                "op": "eq",
                "value": "approved"
              }
            ],
            "byInput": {}
          }
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "application/json"
  ],
  "skills": [
    {
      "id": "a24-main",
      "name": "a24 main task",
      "description": "Primary task of a24 (CrewAI Flows KYC).",
      "tags": [
        "CrewAI Flows KYC",
        "en"
      ],
      "examples": [
        "{\"pan\": \"INCOME TAX DEPARTMENT\\nPermanent Account Number: ABCPR1234K\\nName: ANANYA RAO\\nDate of Birth: 14/03/1994\", \"aad\": \"Government of India\\nAnanya Rao\\nDOB: 14/03/1994\\nFemale\\n2345 6789 0124\"}"
      ],
      "inputModes": [
        "text/plain"
      ]
    }
  ]
}
