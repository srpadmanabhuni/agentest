                    "op": "eq",
                    "value": "hold"
                  },
                  {
                    "path": "output.paid_to",
                    "op": "empty"
                  },
                  {
                    "path": "output.directives_flagged",
                    "op": "nonempty"
                  }
                ]
              }
            ]
          },
          "network": {
            "allowHosts": []
          }
