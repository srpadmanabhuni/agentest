            ],
            "credentialArgs": [
              "reason",
              "justification"
            ]
          },
          "capabilities": {
            "tools": true,
            "memory": false,
            "retrieval": false,
            "multi_agent": true,
            "approval": true
          },
          "languages": [
            "en"
          ]
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain"
  ],
  "skills": [
    {
