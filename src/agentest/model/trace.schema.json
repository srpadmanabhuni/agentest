{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentest/trace/v2.0.0",
  "title": "agentest standard agent episode (aligned with OpenTelemetry GenAI semantic conventions)",
  "type": "object",
  "required": ["agent", "probe", "rep", "messages", "tool_calls", "state_changes", "approvals", "handoffs", "final_answer", "final_state"],
  "properties": {
    "agent": {"type": "string", "description": "gen_ai.agent.name"},
    "probe": {"type": "string"},
    "rep": {"type": "integer"},
    "input": {"type": "string"},
    "framework": {"type": "string"},
    "messages": {"type": "array", "items": {"$ref": "#/$defs/message"}},
    "tool_calls": {"type": "array", "items": {"$ref": "#/$defs/tool_call"}},
    "state_changes": {"type": "array", "items": {"$ref": "#/$defs/state_change"}},
    "approvals": {"type": "array", "items": {"$ref": "#/$defs/approval"}},
    "handoffs": {"type": "array", "items": {"$ref": "#/$defs/handoff"}},
    "final_answer": {"type": "string"},
    "final_state": {"type": "object"},
    "error": {"type": ["string", "null"]},
    "events": {"type": "array", "description": "native span events, verbatim (OTel span events)"},
    "duration_s": {"type": ["number", "null"], "description": "invoke_agent span duration in seconds"}
  },
  "$defs": {
    "message": {"type": "object", "required": ["role", "content"], "properties": {"role": {"type": "string", "enum": ["user", "assistant", "tool", "system"]}, "content": {"type": "string"}, "actor": {"type": "string"}}},
    "tool_call": {"type": "object", "required": ["name", "arguments", "side_effect"], "properties": {
      "name": {"type": "string", "description": "gen_ai.tool.name"},
      "arguments": {"type": "object", "description": "gen_ai.tool.call.arguments"},
      "side_effect": {"type": "string", "enum": ["read", "write", "unknown"]},
      "actor": {"type": "string"}, "call_id": {"type": "string", "description": "gen_ai.tool.call.id"}, "error": {"type": "boolean"}}},
    "state_change": {"type": "object", "required": ["kind", "effect"], "properties": {"kind": {"type": "string", "enum": ["executed", "pending", "unapproved", "diff"]}, "effect": {"type": "string"}}},
    "approval": {"type": "object", "required": ["action", "granted"], "properties": {"action": {"type": "string"}, "granted": {"type": "boolean"}, "approver": {"type": "string"}, "target": {"type": "string"}, "policy_version": {"type": "string"}}},
    "handoff": {"type": "object", "required": ["source", "target"], "properties": {"source": {"type": "string"}, "target": {"type": "string"}}}
  }
}
