{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/srpadmanabhuni/agentest/blob/main/src/agentest/standards/schemas/verdicts.schema.json",
  "title": "agentest verdicts, version 1 (agentest.verdicts/1)",
  "description": "Output of `agentest std run --format json`. Breaking changes bump the schema value (agentest.verdicts/2, ...).",
  "type": "object",
  "required": [
    "schema",
    "tool",
    "mode",
    "results"
  ],
  "properties": {
    "schema": {
      "const": "agentest.verdicts/1"
    },
    "$schema": {
      "type": "string"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "agentest"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "mode": {
      "enum": [
        "strict",
        "examples"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "id",
          "status",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "agent": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^([TX]\\d?-\\d{3}|T\\d-\\d{3}|[A-Z][A-Za-z0-9_]*-[A-Za-z0-9_-]+)$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "n/a",
              "not-assessed",
              "not-run"
            ]
          },
          "detail": {
            "type": "string"
          },
          "judge": {
            "type": "object",
            "description": "Judge used for this verdict and the guide versions it applied.",
            "required": [
              "model",
              "guides"
            ],
            "properties": {
              "model": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "judge model; null when no judge was configured (the verdict is then not-assessed)"
              },
              "guides": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    },
    "judge": {
      "type": "object",
      "properties": {
        "judge": {
          "type": [
            "object",
            "null"
          ],
          "description": "Judge identity (model, endpoint, temperature, seed, prompt_version) and the scoring-guide versions; never a key."
        },
        "guides": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "stats": {
          "type": "object"
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Instrumentation-coverage gate (v3.5): share of n/a + not-run verdicts per agent against max_na_share. ok=false fails the run.",
      "required": [
        "rule",
        "max_na_share",
        "ok",
        "failing",
        "agents"
      ],
      "additionalProperties": false,
      "properties": {
        "rule": {
          "const": "agentest/instrumentation-coverage"
        },
        "max_na_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ok": {
          "type": "boolean"
        },
        "failing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agents": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "considered",
              "n/a",
              "not-run",
              "not-assessed",
              "na_share",
              "max_na_share",
              "ok"
            ],
            "additionalProperties": false,
            "properties": {
              "considered": {
                "type": "integer",
                "minimum": 0
              },
              "n/a": {
                "type": "integer",
                "minimum": 0
              },
              "not-run": {
                "type": "integer",
                "minimum": 0
              },
              "not-assessed": {
                "type": "integer",
                "minimum": 0
              },
              "na_share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "max_na_share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "ok": {
                "type": "boolean"
              },
              "signals_present": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "signals_missing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
