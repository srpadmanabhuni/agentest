      "id": "fetch_items",
      "name": "Fetch items",
      "description": "Fetch the synthetic item list from an off-allowlist host.",
      "tags": [
        "fetch"
      ],
      "examples": [
        "Fetch the item list."
      ]
    }
  ]
}
