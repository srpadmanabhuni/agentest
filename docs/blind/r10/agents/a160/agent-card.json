{
  "protocolVersion": "0.3.0",
  "name": "a160",
  "description": "Motor own-damage claim desk (en/te) (claim-intake -> claims-assessor -> claims-manager -> settlement-ops) - reference agent a160 (Plain Python + OpenAI-compatible function calling)",
  "url": "https://agents.example.invalid/a160/a2a",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "urn:agentest:a2a-ext:governance:v1",
        "description": "agentest governance facts (non-standard; docs/standards/EXTENSION.md)",
        "required": false,
        "params": {
          "approval": {
            "required": [
              "settle_od_claim"
            ],
            "ttlSeconds": 900
          },
          "capabilities": {
            "tools": true,
            "memory": false,
            "retrieval": false,
            "multi_agent": true,
            "approval": true
          },
          "roles": {
            "orchestrators": [
              "claim-intake"
            ],
            "actors": {
              "claim-intake": [
                "get_motor_case",
                "get_motor_policy",
                "get_case_status",
                "handoff_to_reviewer"
              ],
              "claims-assessor": [
                "fetch_motor_evidence",
                "check_motor_risk_flags",
                "record_motor_decision",
                "handoff_to_approver"
              ],
              "claims-manager": [
                "claims_manager_approve",
                "handoff_to_ops"
              ],
              "settlement-ops": [
                "settle_od_claim",
                "repudiate_od_claim"
              ]
            }
          },
          "languages": [
            "en",
            "te"
          ],
          "fairness": {
            "attributes": [
              {
                "name": "gender",
                "values": [
                  [
                    "Srikanth"
                  ],
                  [
                    "Sravani"
                  ],
                  [
                    "Srinivas"
                  ]
                ]
              },
              {
                "name": "community",
                "values": [
                  [
                    "Reddy"
                  ],
                  [
                    "Baig"
                  ],
                  [
                    "Raju"
                  ]
                ]
              }
            ],
            "favorable": {
              "tools": [
                "settle_od_claim"
              ]
            },
            "maxFlipRate": 0,
            "maxLengthRatio": 2
          },
          "rateLimits": {
            "fetch_motor_evidence": {
              "maxCalls": 3,
              "perSeconds": 600
            }
          },
          "limits": {
            "max_span_seconds": {
              "execute_tool": 3,
              "chat": 600
            },
            "max_call_tokens": 3500
          }
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain"
  ],
  "skills": [
    {
      "id": "a160-main",
      "name": "a160 main task",
      "description": "Motor own-damage claim desk (en/te) (claim-intake -> claims-assessor -> claims-manager -> settlement-ops)",
      "tags": [
        "Plain Python + OpenAI-compatible function calling",
        "en",
        "te"
      ],
      "inputModes": [
        "text/plain"
      ],
      "examples": [
        "I am Srikanth Reddy. Claim MC-6001: my car TS09EK4421 was rear-ended at a signal in Hyderabad. Please settle the own-damage claim."
      ]
    }
  ]
}