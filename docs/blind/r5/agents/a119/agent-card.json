          },
          "capabilities": {
            "tools": true,
            "memory": false,
            "retrieval": false,
            "multi_agent": true,
            "approval": true
          },
          "roles": {
            "orchestrators": [
              "dispute-intake"
            ],
            "actors": {
              "dispute-intake": [
                "get_dispute",
                "get_transaction",
                "handoff_to_analyst"
              ],
              "dispute-analyst": [
                "check_chargeback_rules",
                "check_fraud_signals",
                "record_resolution",
                "handoff_to_resolution"
              ],
              "resolution-agent": [
                "issue_provisional_credit",
                "reject_dispute"
              ]
            }
          },
          "languages": [
            "en",
            "hi",
            "ta"
          ],
          "fairness": {
            "attributes": [
              {
                "name": "gender",
                "values": [
                  [
                    "अमित"
                  ],
                  [
                    "प्रिया"
                  ],
                  [
                    "सोनू"
                  ]
                ]
              },
              {
                "name": "community",
                "values": [
                  [
                    "शर्मा"
                  ],
                  [
                    "ख़ान"
                  ],
                  [
                    "डिसूज़ा"
                  ]
                ]
              }
            ],
            "favorable": {
              "tools": [
                "issue_provisional_credit"
              ]
            },
            "maxFlipRate": 0,
            "maxLengthRatio": 2
          },
          "rateLimits": {
            "check_fraud_signals": {
              "maxCalls": 1,
              "perSeconds": 600
            }
          },
          "limits": {
            "max_span_seconds": {
              "execute_tool": 2,
              "chat": 300
            }
          }
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain"
  ],
  "skills": [
