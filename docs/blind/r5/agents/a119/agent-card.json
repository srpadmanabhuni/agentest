{
  "protocolVersion": "0.3.0",
  "name": "a119",
  "description": "Multilingual card-dispute desk, English/Hindi/Tamil (dispute-intake -> dispute-analyst -> resolution-agent) - reference agent a119 (Plain Python + OpenAI-compatible function calling)",
  "url": "https://agents.example.invalid/a119/a2a",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
    "pushNotifications": false,
    "extensions": [
      {
        "uri": "urn:agentest:a2a-ext:governance:v1",
        "description": "agentest governance facts (non-standard; docs/standards/EXTENSION.md)",
        "required": false,
        "params": {
          "approval": {
            "required": [
              "issue_provisional_credit"
            ],
