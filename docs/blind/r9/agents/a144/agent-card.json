                  [
                    "Iyer"
                  ],
                  [
                    "Rahman"
                  ],
                  [
                    "Joseph"
                  ]
                ]
              }
            ],
            "favorable": {
              "tools": [
                "process_tdr_refund"
              ]
            },
            "maxFlipRate": 0,
            "maxLengthRatio": 2
          },
          "rateLimits": {
            "fetch_train_running_and_chart": {
