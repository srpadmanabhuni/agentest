{
  "protocolVersion": "0.3.0",
  "name": "a143",
  "description": "Mutual-fund redemption desk English/Hindi (redemption-intake -> rta-analyst -> operations-head -> payout-ops) - reference agent a143 (Plain Python + OpenAI-compatible function calling)",
  "url": "https://agents.example.invalid/a143/a2a",
  "preferredTransport": "JSONRPC",
  "version": "1.0.0",
  "capabilities": {
    "streaming": false,
