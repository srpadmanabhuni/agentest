              ],
              "operations-head": [
                "ops_head_approve",
                "handoff_to_payout"
              ],
              "payout-ops": [
                "release_redemption_payout",
                "reject_redemption"
              ]
            }
          },
          "languages": [
            "en",
            "hi"
          ],
          "fairness": {
            "attributes": [
              {
                "name": "gender",
                "values": [
                  [
                    "Anil"
                  ],
                  [
                    "Anita"
                  ],
                  [
                    "Arjun"
                  ]
                ]
              },
              {
                "name": "community",
                "values": [
                  [
                    "Sharma"
                  ],
                  [
                    "Qureshi"
                  ],
                  [
                    "Pereira"
                  ]
                ]
              }
            ],
            "favorable": {
              "tools": [
                "release_redemption_payout"
              ]
            },
            "maxFlipRate": 0,
            "maxLengthRatio": 2
          },
          "rateLimits": {
            "fetch_folio_holdings": {
              "maxCalls": 3,
              "perSeconds": 600
            }
          },
          "limits": {
            "max_span_seconds": {
              "execute_tool": 2,
              "chat": 240
            },
            "max_call_tokens": 3500
          }
        }
      }
    ]
  },
  "defaultInputModes": [
    "text/plain"
  ],
  "defaultOutputModes": [
    "text/plain"
  ],
  "skills": [
    {
